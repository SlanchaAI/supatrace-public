# Local development needs no environment settings. Leave optional credentials empty.
# Run: node --env-file=.env scripts/dev.mjs
# Do not expose the local synthetic server to a network.
# AWS-only settings below are ignored by the local server. Use Secrets Manager references in AWS.

# Optional local test billing. Unset means synthetic billing only.
SUPATRACE_DEV_STRIPE_TEST_KEY=

# AWS API and worker settings. These do not provision infrastructure.
ACCOUNT_ERASURE_RULE_ARN=
APP_HOSTS=
AWS_REGION=
BILLING_COMMERCIAL_POLICY_CONFIG=
BILLING_ENTITLEMENT_PROTECTED_TABLES=
BILLING_ENTITLEMENT_WORKER_CONFIG=
BILLING_INBOX_TABLE_NAME=
BILLING_INGRESS_ACCOUNT_ID=
BILLING_INGRESS_API_ID=
BILLING_METER_WORKER_CONFIG=
BILLING_SANDBOX_CONFIG=
BILLING_STATE_TABLE_NAME=
BILLING_WORKER_CONFIG=
BILLING_WORKER_SANDBOX_CONFIG=
CHATGPT_AUTHORIZE_URL=
CHATGPT_CLIENT_ID=
CHATGPT_SECRET_ARN=
CHATGPT_TOKEN_URL=
CHATGPT_USERINFO_URL=
EMAIL_FROM=
GITHUB_CLIENT_ID=
GITHUB_SECRET_ARN=
GITHUB_TECH_CLIENT_ID=
GITHUB_TECH_SECRET_ARN=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_ARN=
IMPORT_POLICY_CONFIG=
INGEST_API_ID=
INGEST_EDGE_TOKEN=
MCP_BRIDGE_ENABLED=false
MFA_ENABLED=false
PAYLOAD_BUCKET=
PLAN_BILLING_SECRET_ARN=
PLAN_BILLING_WEBHOOK_SECRET_ARN=
PLAN_OVERAGE_RULE_ARN=
RETENTION_ERASURE_MODE=
SERVER_PULL_CONFIG=
SSO_EMAIL_DOMAINS=
SSO_IDP_CERT_SECRET_ARN=
SSO_IDP_ISSUER=
SSO_IDP_SSO_URL=
SUPATRACE_ENABLED=false
TABLE_NAME=

# Transport safety check. Never disable TLS verification.
NODE_TLS_REJECT_UNAUTHORIZED=1

# Optional deployment guard identity; the workflow derives it at runtime.
AWS_ACCOUNT_ID=
